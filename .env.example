# Ashian Spatial AI - Environment Example
# Copy this file to .env and configure your keys

# OpenRouter API Key (Free tier models available at openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Models
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Database Configuration
DATABASE_URL=sqlite:///data/spatial_ai.db

# Storage Directories
DATASET_RAW_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
